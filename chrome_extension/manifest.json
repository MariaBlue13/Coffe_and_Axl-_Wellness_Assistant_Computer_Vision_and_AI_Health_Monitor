{
  "manifest_version": 3,
  "name": "Coffee & Axl Monitor",
  "version": "1.0",
  "description": "Monitorizare activitate browser pentru Coffee & Axl",
  "permissions": [
    "tabs",
    "activeTab",
    "webNavigation",
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Coffee & Axl"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}